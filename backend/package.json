{
  "name": "homesync-backend",
  "version": "1.0.0",
  "description": "HomeSync REST API — Express + PostgreSQL, JWT auth, RBAC, SmartMatch, DigiLocker mock adapter, Razorpay integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "migrate": "psql \"$DATABASE_URL\" -f ../database/migrations/000_extensions.sql && psql \"$DATABASE_URL\" -f ../database/migrations/001_init.sql",
    "seed": "psql \"$DATABASE_URL\" -f ../database/seed/seed.sql"
  },
  "keywords": [
    "homesync",
    "sih89",
    "cooperative-marketplace"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  }
}
