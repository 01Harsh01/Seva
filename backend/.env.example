# backend/.env.example
PORT=4000
DEMO_MODE=true

# Database
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=homesync

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# Razorpay — leave blank to run in demo mode (payment endpoints return
# a clear 501 "not configured" instead of pretending to charge anyone)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
COOPERATIVE_FEE_PCT=0.08

# DigiLocker — official credentials required for DigiLockerLiveService.
# Until issued, the app uses DigiLockerMockService automatically.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=

# SmartMatch weights (must sum to 1.0) — optional, defaults match the spec
SMARTMATCH_WEIGHT_SKILL=0.40
SMARTMATCH_WEIGHT_DISTANCE=0.25
SMARTMATCH_WEIGHT_AVAILABILITY=0.15
SMARTMATCH_WEIGHT_RATING=0.10
SMARTMATCH_WEIGHT_EXPERIENCE=0.10

CORS_ORIGIN=*
